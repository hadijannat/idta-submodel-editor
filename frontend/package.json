{
  "name": "idta-submodel-editor-frontend",
  "version": "1.0.0",
  "description": "Universal IDTA Submodel Template Editor Frontend",
  "author": {
    "name": "Hadi Jannatabadi",
    "email": "h.jannatabadi@iat.rwth-aachen.de",
    "url": "https://github.com/hadijannat"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadijannat/idta-submodel-editor.git"
  },
  "bugs": {
    "url": "https://github.com/hadijannat/idta-submodel-editor/issues"
  },
  "homepage": "https://github.com/hadijannat/idta-submodel-editor#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test suites/suite-00-smoke",
    "test:e2e:core": "playwright test suites/suite-01-core-editing suites/suite-02-validation",
    "test:e2e:mapper": "playwright test suites/suite-03-smart-mapper",
    "test:e2e:magic-import": "E2E_PROFILE=magic-import playwright test",
    "test:e2e:dataspace": "E2E_PROFILE=dataspace playwright test",
    "test:e2e:plc": "E2E_PROFILE=plc playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "demo:magic-import": "playwright test e2e/magic-import-demo.spec.ts --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-virtual": "^3.13.21",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "ajv": "^6.14.0"
  }
}
