{
  "name": "idta-submodel-editor-frontend",
  "version": "1.0.0",
  "description": "Universal IDTA Submodel Template Editor Frontend",
  "author": {
    "name": "Hadi Jannatabadi",
    "email": "h.jannatabadi@iat.rwth-aachen.de",
    "url": "https://github.com/hadijannat"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadijannat/idta-submodel-editor.git"
  },
  "bugs": {
    "url": "https://github.com/hadijannat/idta-submodel-editor/issues"
  },
  "homepage": "https://github.com/hadijannat/idta-submodel-editor#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test suites/suite-00-smoke",
    "test:e2e:core": "playwright test suites/suite-01-core-editing suites/suite-02-validation",
    "test:e2e:mapper": "playwright test suites/suite-03-smart-mapper",
    "test:e2e:magic-import": "E2E_PROFILE=magic-import playwright test",
    "test:e2e:dataspace": "E2E_PROFILE=dataspace playwright test",
    "test:e2e:plc": "E2E_PROFILE=plc playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "demo:magic-import": "playwright test e2e/magic-import-demo.spec.ts --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-virtual": "^3.13.18",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^2.0.5"
  }
}
