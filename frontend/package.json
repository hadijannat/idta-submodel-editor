{
  "name": "idta-submodel-editor-frontend",
  "version": "1.0.0",
  "description": "Universal IDTA Submodel Template Editor Frontend",
  "author": {
    "name": "Hadi Jannatabadi",
    "email": "h.jannatabadi@iat.rwth-aachen.de",
    "url": "https://github.com/hadijannat"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadijannat/idta-submodel-editor.git"
  },
  "bugs": {
    "url": "https://github.com/hadijannat/idta-submodel-editor/issues"
  },
  "homepage": "https://github.com/hadijannat/idta-submodel-editor#readme",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test suites/suite-00-smoke",
    "test:e2e:core": "playwright test suites/suite-01-core-editing suites/suite-02-validation",
    "test:e2e:mapper": "playwright test suites/suite-03-smart-mapper",
    "test:e2e:magic-import": "E2E_PROFILE=magic-import playwright test",
    "test:e2e:dataspace": "E2E_PROFILE=dataspace playwright test",
    "test:e2e:plc": "E2E_PROFILE=plc playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "demo:magic-import": "playwright test e2e/magic-import-demo.spec.ts --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-virtual": "^3.14.6",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "ajv": "^6.14.0"
  }
}
