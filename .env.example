# IDTA Submodel Editor - Environment Configuration
# Copy this file to .env and configure your values

# =============================================================================
# LLM Provider Configuration (for Magic Import feature)
# =============================================================================

# OpenAI / OpenRouter (default provider)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1  # Alternative: OpenRouter

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (local LLM)
# OLLAMA_BASE_URL=http://localhost:11434

# Provider selection
MAGIC_IMPORT_LLM_PROVIDER=openai  # Options: openai, anthropic, openrouter, local
MAGIC_IMPORT_LLM_MODEL=gpt-5.5
MAGIC_IMPORT_LLM_MAX_RETRIES=0

# =============================================================================
# GitHub API (optional - for higher rate limits on template fetching)
# =============================================================================

# GITHUB_TOKEN=ghp_your-token-here

# =============================================================================
# Security
# =============================================================================

# Change this in production!
SECRET_KEY=development-secret-key-change-in-production

# =============================================================================
# Feature Flags
# =============================================================================

# MAGIC_IMPORT_ENABLED=true
# MAGIC_IMPORT_ALLOW_VULNERABLE_PYMUPDF=false
# DATASPACE_ENABLED=false
# OIDC_ENABLED=false

# =============================================================================
# Dataspace Configuration (if DATASPACE_ENABLED=true)
# =============================================================================

# BaSyx AAS Server
# BASYX_AAS_SERVER_URL=http://localhost:4001
# BASYX_REGISTRY_URL=http://localhost:4002

# EDC Connector
# EDC_CONTROL_PLANE_URL=http://localhost:19192
# EDC_DATA_PLANE_URL=http://localhost:19291
# EDC_API_KEY=your-api-key

# HashiCorp Vault
# VAULT_URL=http://localhost:8200
# VAULT_TOKEN=dev-root-token
