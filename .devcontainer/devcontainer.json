{
  "name": "IDTA Submodel Editor",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && npm ci --prefix frontend",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/backend"
  },
  "forwardPorts": [
    8000,
    8080
  ],
  "portsAttributes": {
    "8000": {
      "label": "Backend API"
    },
    "8080": {
      "label": "Frontend"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
